{
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "12000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "permissions": {
    "deny": [
      "Read(**/*.jar)",
      "Read(**/*.mca)",
      "Read(mod/.gradle/**)",
      "Read(mod/build/classes/**)",
      "Read(mod/build/tmp/**)",
      "Read(mod/build/libs/**)",
      "Read(refs/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python -I .claude/hooks/guard_read.py"
          }
        ]
      }
    ]
  }
}
